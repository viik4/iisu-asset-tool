/* iiSU Network Theme - Light Mode
 * Matches iiSU Launcher aesthetic with clean panels and gradient accents
 * Light backgrounds with subtle depth
 *
 * Design Philosophy:
 * - Clean, minimal interface with clear visual hierarchy
 * - Soft panel aesthetic with subtle shadows
 * - Cyan-Purple-Magenta gradient accents for selection states
 * - Gentle borders for definition
 *
 * iiSU Color Palette:
 * - Primary Gradient: Cyan (#00DDFF) → Blue (#067DBA) → Purple (#2B1FD0) → Pink (#B71AEB)
 * - Background: #e8eef5 (base) / #FFFFFF (elevated)
 * - Surface: #FFFFFF (panels) / #F0F2F5 (cards)
 * - Text Primary: #0a0a1a
 * - Text Secondary: #4a4a6a
 * - Border: #DADCE0 (subtle) / #C4C8CC (emphasis)
 *
 * Typography Rules:
 * - Continuum Bold: Single word labels, tab names, buttons, short titles
 * - Cal Sans: Multi-word text (2+ words), descriptions, body text, notes
 */

/* Main Window - transparent to show dot pattern */
/* Default to Cal Sans for general body text */
/* Using pt units for DPI-aware font sizing */
/* Font family names must match exactly as registered by QFontDatabase */
QWidget {
    background: transparent;
    color: #0a0a1a;
    font-family: "Cal Sans", "Segoe UI", "Roboto", sans-serif;
    font-size: 12pt;
    font-weight: 400;
}

/* Labels default to Cal Sans (most labels have multi-word text) */
QLabel {
    color: #0a0a1a;
    background: transparent;
    font-family: "Cal Sans", "Segoe UI", "Roboto", sans-serif;
    font-size: 12pt;
}

/* Single-word labels use Continuum Bold - apply via objectName */
/* Letter-spacing helps with display font readability */
QLabel[objectName^="title_"], QLabel[objectName^="short_"], QLabel[objectName^="label_"] {
    font-family: "Continuum Bold", "Continuum", "Segoe UI Semibold", sans-serif;
    font-weight: bold;
    letter-spacing: 1px;
}

/* Headers - single word titles use Continuum Bold */
QLabel#header {
    font-family: "Continuum Bold", "Continuum", "Segoe UI Semibold", sans-serif;
    font-size: 20pt;
    font-weight: bold;
    letter-spacing: 1.5px;
    color: #0a0a1a;
}

/* Subheaders and descriptions - multi-word, use Cal Sans */
QLabel#subheader {
    font-family: "Cal Sans", "Segoe UI", "Roboto", sans-serif;
    font-size: 10pt;
    color: #4a4a6a;
}

/* App Header - clean with subtle bottom accent */
QWidget#app_header {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(255, 255, 255, 0.8),
                                stop:1 rgba(232, 238, 245, 0.6));
    border-bottom: 1px solid rgba(0, 168, 204, 0.3);
}

/* Text areas and descriptions - Cal Sans for text, Consolas for code */
QTextEdit, QPlainTextEdit {
    font-family: "Consolas", "Monaco", "SF Mono", monospace;
    font-size: 10pt;
}

/* Group box titles - typically short, use Continuum Bold */
QGroupBox {
    font-family: "Continuum Bold", "Continuum", "Segoe UI Semibold", sans-serif;
    font-weight: bold;
    letter-spacing: 1px;
    font-size: 11pt;
}

/* Tooltip text - Cal Sans for readable descriptions */
QToolTip {
    font-family: "Cal Sans", "Segoe UI", "Roboto", sans-serif;
    font-size: 10pt;
}

/* Buttons - Clean, modern style matching iiSU Launcher */
QPushButton {
    font-family: "Continuum Bold", "Continuum", "Segoe UI Semibold", sans-serif;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(255, 255, 255, 0.98),
                                stop:0.5 rgba(248, 249, 251, 0.95),
                                stop:1 rgba(240, 242, 245, 0.98));
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 8px;
    padding: 10px 20px;
    color: #0a0a1a;
    font-size: 12pt;
    font-weight: bold;
    letter-spacing: 0.8px;
    min-height: 22px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(0, 212, 255, 0.2),
                                stop:0.5 rgba(0, 190, 230, 0.15),
                                stop:1 rgba(0, 168, 204, 0.2));
    border: 1px solid rgba(0, 212, 255, 0.6);
    color: #007C92;
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(0, 180, 220, 0.35),
                                stop:1 rgba(0, 168, 204, 0.3));
    border: 1px solid rgba(0, 212, 255, 0.8);
}

QPushButton:disabled {
    background: rgba(240, 242, 245, 0.7);
    border: 1px solid rgba(0, 0, 0, 0.08);
    color: #9AA0A6;
}

/* Primary Action Button - iiSU gradient (same as dark theme) */
QPushButton#btn_start {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #2B1FD0, stop:1 #B71AEB);
    border: none;
    color: #FFFFFF;
}

QPushButton#btn_start:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #3A2FE0, stop:1 #C72AFB);
}

QPushButton#btn_start:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #1B0FC0, stop:1 #A70ADB);
}

/* Preview Button - Cyan accent */
QPushButton#btn_preview {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #06B6D4, stop:1 #10B981);
    border: none;
    color: #FFFFFF;
}

QPushButton#btn_preview:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #22D3EE, stop:1 #34D399);
}

/* Input Fields - Clean, focused style */
QLineEdit, QSpinBox, QComboBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(255, 255, 255, 0.98),
                                stop:0.5 rgba(250, 251, 253, 0.95),
                                stop:1 rgba(255, 255, 255, 0.98));
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 8px;
    padding: 10px 14px;
    color: #0a0a1a;
    selection-background-color: rgba(0, 212, 255, 0.3);
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid rgba(0, 212, 255, 0.7);
    background: rgba(255, 255, 255, 1);
}

QLineEdit:hover, QSpinBox:hover, QComboBox:hover {
    border: 1px solid rgba(0, 0, 0, 0.25);
}

QLineEdit::placeholder {
    color: #9AA0A6;
}

/* ComboBox Dropdown - Fixed sizing and visibility */
QComboBox {
    min-height: 32px;
    padding-right: 30px;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    background: transparent;
    subcontrol-origin: padding;
    subcontrol-position: center right;
}

QComboBox::down-arrow {
    image: none;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 7px solid rgba(29, 29, 31, 0.7);
    margin-right: 10px;
    width: 0;
    height: 0;
}

QComboBox::down-arrow:on {
    border-top: none;
    border-bottom: 7px solid rgba(0, 168, 204, 0.9);
}

QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid rgba(0, 168, 204, 0.5);
    border-radius: 8px;
    selection-background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(0, 221, 255, 0.3),
                                stop:0.25 rgba(6, 125, 186, 0.25),
                                stop:0.5 rgba(43, 31, 208, 0.2),
                                stop:1 rgba(183, 26, 235, 0.2));
    selection-color: #007C92;
    color: #0a0a1a;
    outline: none;
    padding: 6px;
    margin-top: 2px;
}

QComboBox QAbstractItemView::item {
    padding: 10px 14px;
    border-radius: 6px;
    margin: 2px;
    min-height: 24px;
    background: transparent;
    color: #0a0a1a;
}

QComboBox QAbstractItemView::item:hover {
    background: rgba(0, 212, 255, 0.15);
}

QComboBox QAbstractItemView::item:selected {
    background: rgba(0, 212, 255, 0.25);
}

/* SpinBox Buttons */
QSpinBox::up-button, QSpinBox::down-button {
    background-color: rgba(232, 238, 245, 0.9);
    border: none;
    width: 20px;
    border-radius: 4px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: rgba(0, 212, 255, 0.15);
}

QSpinBox::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #86868B;
}

QSpinBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #86868B;
}

/* Progress Bar - iiSU gradient signature */
QProgressBar {
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 10px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(240, 242, 245, 0.95),
                                stop:0.5 rgba(235, 238, 242, 0.9),
                                stop:1 rgba(240, 242, 245, 0.95));
    text-align: center;
    color: #0a0a1a;
    height: 24px;
    font-size: 9pt;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00DDFF, stop:0.25 #067DBA, stop:0.5 #2B1FD0, stop:1 #B71AEB);
    border-radius: 9px;
}

/* Text Edit / Log Output - Clean panel style */
QTextEdit {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(255, 255, 255, 0.98),
                                stop:0.5 rgba(250, 251, 253, 0.95),
                                stop:1 rgba(255, 255, 255, 0.98));
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 10px;
    padding: 12px;
    color: #0a0a1a;
    selection-background-color: rgba(0, 212, 255, 0.3);
    font-family: "Consolas", "Monaco", "SF Mono", monospace;
    font-size: 9pt;
}

/* CheckBox - iiSU gradient style */
QCheckBox {
    spacing: 10px;
    color: #0a0a1a;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(0, 0, 0, 0.18);
    border-radius: 5px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(255, 255, 255, 0.98),
                                stop:1 rgba(232, 238, 245, 0.98));
}

QCheckBox::indicator:hover {
    border-color: rgba(0, 212, 255, 0.7);
}

QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00DDFF, stop:0.25 #067DBA, stop:0.5 #2B1FD0, stop:1 #B71AEB);
    border-color: #067DBA;
}

QCheckBox::indicator:checked:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #33DFFF, stop:0.25 #1A8DCA, stop:0.5 #3B2FE0, stop:1 #C72AFB);
}

/* RadioButton - iiSU accent style */
QRadioButton {
    spacing: 10px;
    color: #0a0a1a;
}

QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(0, 0, 0, 0.18);
    border-radius: 10px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(255, 255, 255, 0.98),
                                stop:1 rgba(232, 238, 245, 0.98));
}

QRadioButton::indicator:hover {
    border-color: rgba(0, 212, 255, 0.7);
}

QRadioButton::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00DDFF, stop:0.25 #067DBA, stop:0.5 #2B1FD0, stop:1 #B71AEB);
    border-color: #067DBA;
}

/* List/Tree Widgets - Clean panel style matching iiSU Launcher settings panel */
QListWidget, QTreeWidget {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(255, 255, 255, 0.98),
                                stop:0.5 rgba(250, 251, 253, 0.95),
                                stop:1 rgba(255, 255, 255, 0.98));
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 12px;
    padding: 8px;
    outline: none;
}

QListWidget::item, QTreeWidget::item {
    background: transparent;
    border: none;
    border-bottom: 1px solid transparent;
    border-radius: 0px;
    padding: 12px 16px;
    margin: 0px;
}

QListWidget::item:hover, QTreeWidget::item:hover {
    background: rgba(0, 212, 255, 0.06);
    border-bottom: 1px solid rgba(0, 212, 255, 0.15);
}

/* Selected item - purple/cyan gradient underline indicator like iiSU Launcher */
QListWidget::item:selected, QTreeWidget::item:selected {
    background: rgba(0, 212, 255, 0.08);
    border-bottom: 2px solid qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00DDFF, stop:0.25 #067DBA, stop:0.5 #2B1FD0, stop:1 #B71AEB);
    color: #007C92;
}

/* Scrollbars - Fluid water aesthetic */
QScrollBar:vertical {
    background: rgba(232, 238, 245, 0.5);
    width: 10px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(174, 174, 178, 0.6),
                                stop:0.5 rgba(160, 160, 165, 0.5),
                                stop:1 rgba(174, 174, 178, 0.6));
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(0, 212, 255, 0.6),
                                stop:0.5 rgba(6, 182, 212, 0.5),
                                stop:1 rgba(0, 212, 255, 0.6));
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: rgba(232, 238, 245, 0.5);
    height: 10px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(174, 174, 178, 0.6),
                                stop:0.5 rgba(160, 160, 165, 0.5),
                                stop:1 rgba(174, 174, 178, 0.6));
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(0, 212, 255, 0.6),
                                stop:0.5 rgba(6, 182, 212, 0.5),
                                stop:1 rgba(0, 212, 255, 0.6));
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Tooltips - Dark style with cyan accent (consistent with dark theme) */
QToolTip {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(45, 50, 56, 0.98),
                                stop:1 rgba(35, 40, 46, 0.98));
    color: #FFFFFF;
    border: 1px solid rgba(0, 212, 255, 0.6);
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 9pt;
}

/* Dialogs - Light panel style */
QDialog {
    background-color: #e8eef5;
}

QMessageBox {
    background-color: #e8eef5;
}

QMessageBox QLabel {
    color: #0a0a1a;
}

/* Group Box - Panel containers with subtle accent */
QGroupBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(255, 255, 255, 0.8),
                                stop:1 rgba(250, 251, 253, 0.7));
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 12px;
    margin-top: 20px;
    padding: 16px;
    padding-top: 28px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 6px 14px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(0, 212, 255, 0.15),
                                stop:1 rgba(6, 125, 186, 0.1));
    border-radius: 6px;
    color: #0a0a1a;
}

/* Frame - transparent */
QFrame {
    background: transparent;
    border: none;
    border-radius: 0px;
}

QFrame[frameShape="4"], QFrame[frameShape="5"] {
    color: rgba(0, 0, 0, 0.1);
}

/* Card style for QFrame panels */
QFrame#card, QFrame#results_card, QFrame#preview_card, QFrame#platform_card {
    background-color: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 16px;
}

/* Search results list specific styling */
QListWidget#search_results_list {
    background-color: #e8eef5;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 6px;
    outline: none;
    padding: 4px;
}

QListWidget#search_results_list::item {
    padding: 10px 12px;
    margin: 2px 0;
    border-radius: 4px;
    background-color: #FFFFFF;
    color: #1D1D1F;
}

QListWidget#search_results_list::item:hover {
    background-color: #E8E8E8;
    border: 1px solid rgba(0, 0, 0, 0.15);
}

QListWidget#search_results_list::item:selected {
    background-color: #007AFF;
    color: white;
    border: 1px solid #0066CC;
}

QListWidget#search_results_list::item:selected:hover {
    background-color: #0088FF;
}

/* Tab Widget - Clean tab bar matching iiSU Launcher navigation */
QTabWidget::pane {
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.5);
    top: -1px;
}

QTabWidget::tab-bar {
    alignment: left;
}

QTabBar::tab {
    font-family: "Continuum Bold", "Continuum", "Segoe UI Semibold", sans-serif;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
    padding: 14px 24px;
    margin-right: 2px;
    color: rgba(26, 30, 34, 0.5);
    font-size: 11pt;
    font-weight: bold;
    letter-spacing: 1px;
    min-width: 100px;
}

QTabBar::tab:hover {
    background: rgba(0, 212, 255, 0.06);
    color: #007C92;
    border-bottom: 2px solid rgba(0, 212, 255, 0.3);
}

/* Selected tab - gradient underline indicator */
QTabBar::tab:selected {
    background: rgba(0, 212, 255, 0.08);
    border-bottom: 2px solid qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00DDFF, stop:0.25 #067DBA, stop:0.5 #2B1FD0, stop:1 #B71AEB);
    color: #007C92;
}

QTabBar::tab:!selected {
    margin-top: 0px;
}

/* Main Window - transparent to show dot pattern */
QMainWindow {
    background: transparent;
}

QMainWindow::separator {
    background: rgba(0, 0, 0, 0.1);
    width: 1px;
    height: 1px;
}

/* Splitter - Visible drag handle for resizing panels */
QSplitter::handle {
    background-color: rgba(0, 0, 0, 0.08);
    width: 6px;
    height: 6px;
}

QSplitter::handle:horizontal {
    width: 6px;
    image: none;
    border-left: 1px solid rgba(0, 0, 0, 0.12);
    border-right: 1px solid rgba(0, 0, 0, 0.12);
}

QSplitter::handle:vertical {
    height: 6px;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
}

QSplitter::handle:hover {
    background-color: rgba(0, 212, 255, 0.3);
    border-color: #007C92;
}

/* Scroll Area */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* Dialog Button Box */
QDialogButtonBox QPushButton {
    min-width: 80px;
}

/* Links in Labels */
QLabel a {
    color: #0891B2;
    text-decoration: none;
}

QLabel a:hover {
    color: #06B6D4;
}

/* ROM Browser specific widgets - iiSU Launcher list style */
QTreeWidget#rom_platform_tree {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(255, 255, 255, 0.98),
                                stop:0.5 rgba(250, 251, 253, 0.95),
                                stop:1 rgba(255, 255, 255, 0.98));
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 12px;
}

QTreeWidget#rom_platform_tree::item {
    padding: 12px 16px;
    border: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    margin: 0px;
}

QTreeWidget#rom_platform_tree::item:selected {
    background: rgba(0, 212, 255, 0.08);
    border-bottom: 2px solid qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00DDFF, stop:0.25 #067DBA, stop:0.5 #2B1FD0, stop:1 #B71AEB);
    color: #007C92;
}

QTreeWidget#rom_platform_tree::item:hover:!selected {
    background: rgba(0, 212, 255, 0.05);
}

QListWidget#rom_games_list {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(255, 255, 255, 0.98),
                                stop:0.5 rgba(250, 251, 253, 0.95),
                                stop:1 rgba(255, 255, 255, 0.98));
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 12px;
}

QListWidget#rom_games_list::item {
    padding: 12px 16px;
    border: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    margin: 0px;
    background: transparent;
}

QListWidget#rom_games_list::item:selected {
    background: rgba(0, 212, 255, 0.08);
    border-bottom: 2px solid qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00DDFF, stop:0.25 #067DBA, stop:0.5 #2B1FD0, stop:1 #B71AEB);
    color: #007C92;
}

QListWidget#rom_games_list::item:hover:!selected {
    background: rgba(0, 212, 255, 0.05);
}

/* ===== CUSTOM TAB SPECIFIC STYLES ===== */

/* Sub-tabs for Custom tab (Icons/Borders/Covers) */
QTabWidget#custom_sub_tabs::pane {
    border: none;
    background: transparent;
}

QTabWidget#custom_sub_tabs QTabBar {
    background: transparent;
}

QTabWidget#custom_sub_tabs QTabBar::tab {
    background: rgba(240, 242, 245, 0.8);
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 20px;
    margin-right: 4px;
    color: #4a4a6a;
    font-size: 10pt;
}

QTabWidget#custom_sub_tabs QTabBar::tab:selected {
    background: rgba(0, 212, 255, 0.1);
    border-color: rgba(0, 212, 255, 0.5);
    border-bottom: 2px solid #00DDFF;
    color: #007C92;
}

QTabWidget#custom_sub_tabs QTabBar::tab:hover:!selected {
    background: rgba(0, 212, 255, 0.06);
    color: #0a0a1a;
}

/* Card panels */
QFrame#card {
    background-color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 16px;
}

/* Layer toggle buttons - active state */
QPushButton#layer_btn_active {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(0, 212, 255, 0.3), stop:1 rgba(183, 26, 235, 0.3));
    border: 2px solid #00DDFF;
    border-radius: 6px;
    color: #007C92;
    font-weight: bold;
    font-size: 11pt;
    padding: 8px 16px;
}

QPushButton#layer_btn_active:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(0, 212, 255, 0.4), stop:1 rgba(183, 26, 235, 0.4));
    border: 2px solid #20E4FF;
}

QPushButton#layer_btn_active:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(0, 180, 223, 0.4), stop:1 rgba(150, 20, 200, 0.4));
    border: 2px solid #00B4DF;
}

/* Layer toggle buttons - inactive state */
QPushButton#layer_btn_inactive {
    background-color: rgba(240, 242, 245, 0.8);
    border: 2px solid rgba(0, 0, 0, 0.15);
    border-radius: 6px;
    color: #4a4a6a;
    font-weight: bold;
    font-size: 11pt;
    padding: 8px 16px;
}

QPushButton#layer_btn_inactive:hover {
    background-color: rgba(0, 212, 255, 0.08);
    border: 2px solid rgba(0, 0, 0, 0.2);
    color: #0a0a1a;
}

QPushButton#layer_btn_inactive:pressed {
    background-color: rgba(0, 212, 255, 0.15);
    border: 2px solid rgba(0, 0, 0, 0.2);
}

/* Primary action button (cyan gradient) */
QPushButton#btn_primary {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #00DDFF, stop:1 #3d7eff);
    color: white;
    font-weight: bold;
    font-size: 11pt;
    border: 1px solid rgba(0, 212, 255, 0.5);
    border-radius: 6px;
    padding: 6px 12px;
}

QPushButton#btn_primary:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #20E4FF, stop:1 #5a8fff);
    border: 1px solid rgba(32, 228, 255, 0.7);
}

QPushButton#btn_primary:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #00B4DF, stop:1 #2d5edf);
    border: 1px solid rgba(0, 180, 223, 0.8);
}

/* Secondary button */
QPushButton#btn_secondary {
    background-color: rgba(240, 242, 245, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 6px;
    padding: 6px 12px;
    color: #4a4a6a;
    font-size: 11pt;
}

QPushButton#btn_secondary:hover {
    background-color: rgba(0, 212, 255, 0.1);
    border: 1px solid rgba(0, 0, 0, 0.2);
    color: #0a0a1a;
}

QPushButton#btn_secondary:pressed {
    background-color: rgba(0, 212, 255, 0.2);
    border: 1px solid rgba(0, 0, 0, 0.2);
}

/* Small buttons */
QPushButton#btn_small {
    background: transparent;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 4px;
    padding: 2px 8px;
    color: #4a4a6a;
    font-size: 10pt;
}

QPushButton#btn_small:hover {
    background-color: rgba(0, 212, 255, 0.08);
    border: 1px solid rgba(0, 0, 0, 0.2);
    color: #0a0a1a;
}

QPushButton#btn_small:pressed {
    background-color: rgba(0, 212, 255, 0.15);
    border: 1px solid rgba(0, 0, 0, 0.2);
}

/* Clear buttons (danger style on hover) */
QPushButton#btn_clear {
    background: transparent;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 4px;
    padding: 4px 8px;
    color: #9AA0A6;
    font-size: 10pt;
}

QPushButton#btn_clear:enabled {
    color: #4a4a6a;
}

QPushButton#btn_clear:enabled:hover {
    background-color: rgba(255, 68, 68, 0.1);
    border-color: #ff4444;
    color: #ff4444;
}

/* Export button (iiSU gradient) */
QPushButton#btn_export {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #00DDFF, stop:0.25 #067DBA, stop:0.5 #2B1FD0, stop:1 #B71AEB);
    color: white;
    font-weight: bold;
    font-size: 12pt;
    border: 1px solid rgba(0, 212, 255, 0.5);
    border-radius: 6px;
    padding: 10px 16px;
}

QPushButton#btn_export:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #20E4FF, stop:0.25 #1A8DCA, stop:0.5 #3B2FE0, stop:1 #C72AFB);
    border: 1px solid rgba(32, 228, 255, 0.7);
}

QPushButton#btn_export:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #00B4DF, stop:0.25 #056DAA, stop:0.5 #1B0FC0, stop:1 #A70ADB);
    border: 1px solid rgba(0, 180, 223, 0.8);
}

QPushButton#btn_export:disabled {
    background: rgba(240, 242, 245, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.1);
    color: #9AA0A6;
}

/* Card title labels */
QLabel#label_card_title {
    font-size: 13pt;
    font-weight: bold;
    color: #0a0a1a;
}

/* Muted/info labels - slightly darker for better readability in light mode */
QLabel#label_muted {
    font-size: 11pt;
    color: #666666;
}

QLabel#label_info {
    font-size: 11pt;
    color: #4a4a6a;
}

/* Value display labels (accent color) */
QLabel#label_value {
    font-size: 11pt;
    font-weight: bold;
    color: #007C92;
}

/* Warning labels */
QLabel#label_warning {
    font-size: 11pt;
    font-weight: bold;
    color: #b87a00;
}

/* Small checkbox */
QCheckBox#cb_small {
    font-size: 11pt;
    color: #4a4a6a;
}

/* Options dialog tab styling */
QTabWidget#options_tabs::pane {
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.8);
}

QTabWidget#options_tabs QTabBar::tab {
    padding: 8px 20px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    background: rgba(240, 242, 245, 0.8);
    color: #4a4a6a;
    font-size: 11pt;
}

QTabWidget#options_tabs QTabBar::tab:selected {
    background: rgba(0, 212, 255, 0.1);
    color: #007C92;
    border-bottom: 2px solid #00DDFF;
    font-weight: bold;
}

QTabWidget#options_tabs QTabBar::tab:hover:!selected {
    background: rgba(0, 212, 255, 0.06);
    color: #0a0a1a;
}

/* Clickable icon preview (existing assets tab) */
ClickableIconPreview {
    border: 2px solid rgba(0, 0, 0, 0.12);
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.9);
}

ClickableIconPreview:hover {
    border-color: rgba(0, 212, 255, 0.4);
    background-color: rgba(0, 212, 255, 0.05);
}

ClickableIconPreview[selected="true"] {
    border: 2px solid #00DDFF;
    background-color: rgba(0, 212, 255, 0.1);
}

/* Panel cards for various tabs — frosted glass */
QFrame#header_card, QFrame#action_card, QFrame#platform_panel, QFrame#icons_panel {
    background-color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 16px;
}

/* Badge labels (count badges) */
QLabel#badge {
    background-color: rgba(0, 212, 255, 0.15);
    border: 1px solid #007C92;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11pt;
    color: #007C92;
}

/* Action button (cyan gradient primary) */
QPushButton#btn_action {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #00DDFF, stop:1 #3d7eff);
    color: white;
    font-weight: bold;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
}

QPushButton#btn_action:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #20E4FF, stop:1 #5a8fff);
}

QPushButton#btn_action:disabled {
    background: rgba(240, 242, 245, 0.9);
    color: #9AA0A6;
}

/* Select button (outline style) */
QPushButton#btn_select {
    background-color: rgba(0, 212, 255, 0.1);
    border: 1px solid #007C92;
    border-radius: 6px;
    color: #007C92;
    font-size: 11pt;
}

QPushButton#btn_select:hover {
    background-color: rgba(0, 212, 255, 0.2);
}

/* Danger button (delete) */
QPushButton#btn_danger {
    background-color: rgba(255, 68, 68, 0.1);
    border: 1px solid #ff4444;
    border-radius: 6px;
    padding: 8px 12px;
    color: #ff4444;
}

QPushButton#btn_danger:hover {
    background-color: rgba(255, 68, 68, 0.2);
}

QPushButton#btn_danger:disabled {
    background-color: rgba(240, 242, 245, 0.7);
    border-color: #9AA0A6;
    color: #9AA0A6;
}

/* Success button (push to device) */
QPushButton#btn_success {
    background-color: rgba(0, 124, 80, 0.1);
    border: 1px solid #007C50;
    border-radius: 6px;
    padding: 8px 12px;
    color: #007C50;
}

QPushButton#btn_success:hover {
    background-color: rgba(0, 124, 80, 0.2);
}

QPushButton#btn_success:disabled {
    background-color: rgba(240, 242, 245, 0.7);
    border-color: #9AA0A6;
    color: #9AA0A6;
}

/* Artwork option frame */
ArtworkOption {
    border: 2px solid rgba(0, 0, 0, 0.12);
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.9);
    padding: 4px;
}

ArtworkOption:hover {
    border-color: #007C92;
}

/* Filter chips (checkable buttons for filtering) */
QPushButton#filter_chip {
    background-color: rgba(240, 242, 245, 0.9);
    color: #4a4a6a;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 14px;
    padding: 4px 12px;
    font-size: 10pt;
}

QPushButton#filter_chip:checked {
    background-color: #007C92;
    color: white;
    border-color: #007C92;
}

QPushButton#filter_chip:hover:!checked {
    border-color: #007C92;
    color: #007C92;
}

/* Success label (green) */
QLabel#label_success {
    color: #2E7D32;
    font-size: 10pt;
}

/* Error label (red) */
QLabel#label_error {
    color: #C62828;
    font-size: 10pt;
}

/* Warning label (orange/amber) */
QLabel#label_warning {
    color: #b87a00;
    font-size: 10pt;
}

/* Header label (larger) */
QLabel#label_header {
    font-size: 14pt;
    font-weight: bold;
    color: #0a0a1a;
}

/* Accent label (cyan) */
QLabel#label_accent {
    color: #007C92;
    font-size: 11pt;
}

/* Credit label (cyan italic) */
QLabel#label_credit {
    color: #007C92;
    font-size: 10pt;
    font-style: italic;
}

/* Border/image preview thumbnail */
QLabel#border_preview {
    border: 2px solid #C4C8CC;
    border-radius: 8px;
    background: #F0F2F5;
}

QLabel#border_preview_small {
    border: 2px solid #C4C8CC;
    border-radius: 4px;
    background: #F0F2F5;
}

/* Orange/warning button (crop button) */
QPushButton#btn_warning {
    background-color: #b87a00;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 10pt;
}

QPushButton#btn_warning:hover {
    background-color: #FF6D00;
}

/* ========== GAME CARD WIDGET STYLES ========== */

/* Game card base styling — glass */
QFrame#game_card {
    background-color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 12px;
}

QFrame#game_card:hover {
    border-color: rgba(0, 124, 146, 0.5);
    background-color: rgba(255, 255, 255, 0.95);
}

QFrame#game_card[selected="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(0, 124, 146, 0.15),
        stop:1 rgba(103, 58, 183, 0.1));
    border: 2px solid #007C92;
}

/* Game card title label */
QLabel#game_card_title {
    color: #4a4a6a;
    font-size: 9pt;
}

/* Game card image container */
QLabel#game_card_image {
    background-color: rgba(240, 242, 245, 0.8);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 8px;
}

/* Asset status badges */
QLabel#asset_badge_found {
    background-color: rgba(143, 255, 177, 0.9);
    color: white;
    font-size: 7pt;
    font-weight: bold;
    border-radius: 3px;
    padding: 1px 3px;
}

QLabel#asset_badge_missing {
    background-color: rgba(200, 200, 200, 0.5);
    color: #999999;
    font-size: 7pt;
    font-weight: bold;
    border-radius: 3px;
    padding: 1px 3px;
}

/* Games scroll area container */
QScrollArea#games_scroll_area {
    background: transparent;
    border: none;
}

QWidget#games_grid_container {
    background: transparent;
}

/* Icon button style (transparent with hover effect) */
QPushButton#btn_icon {
    background: transparent;
    border: none;
    color: #808080;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#btn_icon:hover {
    color: #007C92;
}

/* Preview frame styling — glass */
QFrame#preview_frame,
QFrame#preview_panel {
    background-color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 16px;
}

/* ========== SOUNDBYTE TAB STYLES ========== */

/* Album card base styling — glass */
QFrame#album_card {
    background-color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 12px;
}

QFrame#album_card:hover {
    border-color: rgba(0, 124, 146, 0.5);
    background-color: rgba(255, 255, 255, 0.95);
}

QFrame#album_card[selected="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(0, 212, 255, 0.15),
        stop:1 rgba(6, 125, 186, 0.1));
    border: 2px solid #00DDFF;
}

/* Album cover placeholder */
QLabel#album_cover {
    background-color: rgba(240, 242, 245, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 6px;
}

/* Album title label */
QLabel#album_title {
    color: #0a0a1a;
    font-size: 11px;
}

/* Track list container */
QFrame#track_list_panel {
    background-color: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 8px;
}

/* Track list item */
QListWidget#track_list {
    background-color: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 6px;
}

QListWidget#track_list::item {
    padding: 8px 12px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    color: #0a0a1a;
}

QListWidget#track_list::item:hover {
    background-color: rgba(0, 212, 255, 0.08);
}

QListWidget#track_list::item:selected {
    background-color: rgba(0, 212, 255, 0.15);
    color: #007C92;
}

/* Selected track info panel */
QFrame#selected_track_panel {
    background-color: rgba(0, 212, 255, 0.08);
    border: 1px solid rgba(0, 212, 255, 0.3);
    border-radius: 6px;
}

/* ========== ASSET DB TAB STYLES ========== */

/* Asset type tabs (Icons/Heroes/Logos/Screenshots) */
QTabWidget#asset_tabs::pane {
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.7);
}

QTabWidget#asset_tabs QTabBar::tab {
    background-color: rgba(240, 242, 245, 0.9);
    color: #4a4a6a;
    padding: 6px 14px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabWidget#asset_tabs QTabBar::tab:selected {
    background-color: rgba(0, 212, 255, 0.12);
    color: #007C92;
    border-bottom: 2px solid #007C92;
}

QTabWidget#asset_tabs QTabBar::tab:hover:!selected {
    background-color: rgba(0, 212, 255, 0.06);
}

/* Asset variant card — glass */
QFrame#variant_card {
    background-color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 12px;
}

QFrame#variant_card:hover {
    border-color: rgba(0, 124, 146, 0.5);
    background-color: rgba(255, 255, 255, 0.95);
}

QFrame#variant_card[selected="true"] {
    background-color: rgba(0, 212, 255, 0.1);
    border: 2px solid #00DDFF;
}

/* Variant preview label */
QLabel#variant_preview {
    background-color: rgba(240, 242, 245, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 6px;
}

/* Asset preview popup tabs */
QTabWidget#asset_preview_tabs::pane {
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.9);
}

/* Asset preview frame */
QFrame#asset_preview_frame {
    background-color: rgba(240, 242, 245, 0.8);
    border: 2px solid rgba(0, 0, 0, 0.1);
    border-radius: 8px;
}

/* Selected variant info panel */
QFrame#variant_info_panel {
    background-color: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 8px;
}

/* Workshop header card */
QFrame#workshop_header {
    background-color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 16px;
    padding: 12px;
}

/* Workshop game card — glass */
QFrame#workshop_game_card {
    background-color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 12px;
}

QFrame#workshop_game_card:hover {
    background-color: rgba(255, 255, 255, 0.95);
    border-color: rgba(0, 124, 146, 0.5);
}

QLabel#workshop_card_preview {
    background-color: rgba(240, 242, 245, 0.8);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 8px;
}

QLabel#workshop_card_name {
    color: #1D1D1F;
    font-size: 11px;
}

QLabel#workshop_card_badge {
    color: #6B4FBB;
    font-size: 10px;
}

/* Workshop filter bar labels and combos */
QLabel#filter_label {
    color: rgba(80, 60, 140, 0.6);
    font-size: 9px;
    font-weight: bold;
    letter-spacing: 1px;
    padding-left: 2px;
}

QComboBox#filter_combo {
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(0, 120, 180, 0.3);
    border-radius: 8px;
    padding: 8px 14px;
    padding-right: 30px;
    color: #1a1a2e;
    min-height: 32px;
    font-size: 12px;
}

QComboBox#filter_combo:hover {
    border: 1px solid rgba(0, 120, 180, 0.5);
}

QComboBox#filter_combo:focus {
    border: 1px solid rgba(0, 120, 180, 0.8);
}

QComboBox#filter_combo::drop-down {
    border: none;
    width: 28px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    background: transparent;
    subcontrol-origin: padding;
    subcontrol-position: center right;
}

QComboBox#filter_combo::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid rgba(0, 120, 180, 0.6);
    margin-right: 10px;
    width: 0;
    height: 0;
}

QComboBox#filter_combo::down-arrow:on {
    border-top: none;
    border-bottom: 6px solid rgba(0, 120, 180, 0.9);
}

QComboBox#filter_combo QAbstractItemView {
    background: #f5f5fa;
    border: 1px solid rgba(0, 120, 180, 0.4);
    border-radius: 8px;
    selection-background-color: rgba(0, 120, 180, 0.15);
    selection-color: #1a1a2e;
    color: #1a1a2e;
    outline: none;
    padding: 4px;
    margin-top: 2px;
}

QComboBox#filter_combo QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 6px;
    margin: 2px;
    min-height: 22px;
}

QComboBox#filter_combo QAbstractItemView::item:hover {
    background: rgba(0, 120, 180, 0.1);
}

QComboBox#filter_combo QAbstractItemView::item:selected {
    background: rgba(0, 120, 180, 0.2);
}

/* Official badge on workshop game cards */
QLabel#workshop_badge_official {
    background-color: rgba(0, 140, 200, 0.15);
    border: 1px solid rgba(0, 140, 200, 0.4);
    border-radius: 3px;
    padding: 1px 6px;
    font-size: 9px;
    font-weight: bold;
    color: #007AAF;
}

/* Shared preview border frame (border/cover/icon generators) */
QLabel#preview_border_frame, QFrame#preview_border_frame {
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 8px;
}

/* ROM browser preview labels */
QLabel#rom_preview_label {
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 6px;
    background-color: rgba(240, 242, 245, 0.8);
}

/* ========== ICON GENERATOR TAB STYLES ========== */

/* Platform icon card */
QFrame#platform_icon_card {
    background-color: rgba(255, 255, 255, 0.9);
    border: 2px solid rgba(0, 0, 0, 0.12);
    border-radius: 8px;
}

QFrame#platform_icon_card:hover {
    border-color: rgba(0, 124, 146, 0.5);
}

QFrame#platform_icon_card[selected="true"] {
    border: 2px solid #00DDFF;
    background-color: rgba(0, 212, 255, 0.08);
}

/* Platform icon image */
QLabel#platform_icon {
    background-color: rgba(240, 242, 245, 0.5);
    border-radius: 4px;
}

/* Platform name label */
QLabel#platform_name {
    color: #0a0a1a;
    font-size: 10px;
}

/* Filter chips container */
QFrame#filter_chips_container {
    background-color: transparent;
}

/* Size toggle buttons */
QPushButton#size_toggle {
    background-color: rgba(240, 242, 245, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 4px;
    padding: 4px 8px;
    color: #4a4a6a;
}

QPushButton#size_toggle:checked {
    background-color: rgba(0, 212, 255, 0.15);
    border-color: #007C92;
    color: #007C92;
}

QPushButton#size_toggle:hover:!checked {
    background-color: rgba(0, 212, 255, 0.08);
}

/* Results area */
QWidget#results_area {
    background-color: rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
}

/* ========== OPTIONS DIALOG STYLES ========== */

/* Section frame in options */
QFrame#options_section {
    background-color: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 8px;
}

/* Section title */
QLabel#section_title {
    color: #00DDFF;
    font-size: 13pt;
    font-weight: bold;
}

/* Platform list widget */
QListWidget#platform_list {
    background-color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 6px;
}

QListWidget#platform_list::item {
    border-radius: 6px;
    padding: 4px;
    border: 2px solid transparent;
    color: #0a0a1a;
}

QListWidget#platform_list::item:hover {
    background: rgba(0, 212, 255, 0.1);
    border: 2px solid rgba(0, 124, 146, 0.3);
}

QListWidget#platform_list::item:selected {
    background: rgba(0, 212, 255, 0.15);
    border: 2px solid #007C92;
}

/* Gold action button */
QPushButton#btn_gold {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #FFE57C, stop:1 #E59E18);
    color: #0a0a0f;
    font-weight: bold;
    border: none;
    border-radius: 8px;
}

QPushButton#btn_gold:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #FFEE99, stop:1 #F5AE28);
}

/* Green accent button */
QPushButton#btn_green {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #8FFFB1, stop:1 #007C92);
    color: #0a0a0f;
    font-weight: bold;
    border: none;
    border-radius: 8px;
}

QPushButton#btn_green:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #A5FFC5, stop:1 #008CA2);
}

/* ──────────────────────────────────────────────────────────
   ACTIVE LAYER INDICATOR (Custom tab)
   ────────────────────────────────────────────────────────── */

QLabel#active_layer_indicator {
    font-size: 10px;
    font-weight: bold;
    color: #007C92;
    padding: 2px 8px;
    border: 1px solid rgba(0, 124, 146, 0.3);
    border-radius: 4px;
    background: rgba(0, 124, 146, 0.1);
}

/* ──────────────────────────────────────────────────────────
   ONBOARDING OVERLAY  (full-window) — Light Theme
   ────────────────────────────────────────────────────────── */

/* Glass card — light frosted panel */
QFrame#onboarding_card {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(255, 255, 255, 0.95),
                                stop:0.5 rgba(248, 250, 252, 0.92),
                                stop:1 rgba(245, 247, 250, 0.95));
    border: 1px solid rgba(0, 124, 146, 0.15);
    border-radius: 20px;
}

QLabel#onboarding_icon {
    background: transparent;
    font-size: 56px;
    color: #1D1D1F;
}

QLabel#onboarding_badge {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(0, 124, 146, 0.12),
                                stop:1 rgba(43, 31, 208, 0.08));
    border: 1px solid rgba(0, 124, 146, 0.3);
    border-radius: 12px;
    padding: 2px 16px;
    font-family: "Continuum Bold", "Continuum", sans-serif;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1.5px;
    color: #007C92;
    max-width: 80px;
}

QLabel#onboarding_title {
    font-family: "Continuum Bold", "Continuum", "Segoe UI Semibold", sans-serif;
    font-size: 28px;
    font-weight: bold;
    color: #1D1D1F;
    letter-spacing: 1.2px;
    background: transparent;
}

QLabel#onboarding_body {
    font-family: "Cal Sans", "Segoe UI", "Roboto", sans-serif;
    font-size: 14px;
    color: #555555;
    line-height: 1.6;
    background: transparent;
}

QFrame#onboarding_accent_line {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(0, 124, 146, 0.0),
                                stop:0.2 rgba(0, 124, 146, 0.35),
                                stop:0.5 rgba(43, 31, 208, 0.25),
                                stop:0.8 rgba(183, 26, 235, 0.3),
                                stop:1.0 rgba(183, 26, 235, 0.0));
    border: none;
    border-radius: 1px;
}

QFrame#progress_active {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #007C92, stop:1 #005F70);
    border: none;
    border-radius: 2px;
}

QFrame#progress_inactive {
    background: rgba(0, 0, 0, 0.06);
    border: none;
    border-radius: 2px;
}

QPushButton#onboarding_btn_back {
    background: transparent;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 8px;
    padding: 6px 20px;
    color: #666666;
    font-family: "Continuum Bold", "Continuum", sans-serif;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 0.6px;
}

QPushButton#onboarding_btn_back:hover {
    background: rgba(0, 0, 0, 0.04);
    border-color: rgba(0, 0, 0, 0.18);
    color: #333333;
}

QPushButton#onboarding_btn_next {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #007C92, stop:1 #005F70);
    border: none;
    border-radius: 8px;
    padding: 6px 24px;
    color: #FFFFFF;
    font-family: "Continuum Bold", "Continuum", sans-serif;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 0.6px;
}

QPushButton#onboarding_btn_next:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #008CA2, stop:1 #006F80);
}

QPushButton#onboarding_btn_next:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #006C82, stop:1 #004F60);
}

QWidget#onboarding_progress_container {
    background: transparent;
}

/* ── Interactive preview canvas ── */
QLabel#preview_canvas {
    background: #f0f2f5;
    border: 2px solid rgba(0, 0, 0, 0.1);
    border-radius: 8px;
}

/* ── Color swatch preview ── */
QLabel#color_swatch {
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 4px;
}

/* ── Context menu (shared across tabs) ── */
QMenu#context_menu {
    background-color: #FFFFFF;
    border: 1px solid rgba(0, 124, 146, 0.4);
    border-radius: 8px;
    padding: 6px;
}

QMenu#context_menu::item {
    padding: 10px 20px;
    border-radius: 6px;
    color: #1a1a2e;
}

QMenu#context_menu::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(0, 124, 146, 0.15),
        stop:1 rgba(100, 80, 160, 0.12));
}

QMenu#context_menu::separator {
    height: 1px;
    background: rgba(0, 0, 0, 0.1);
    margin: 4px 10px;
}

/* ── ROM log text area ── */
QTextEdit#rom_log_text {
    background-color: #f5f7fa;
    color: #1a1a2e;
    font-family: Consolas, Monaco, monospace;
    font-size: 11px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 4px;
}
