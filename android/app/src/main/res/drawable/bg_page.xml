<?xml version="1.0" encoding="utf-8"?>
<!-- Page background with simplified gradients to prevent banding (iiSU Network style) -->
<!-- Uses fewer gradient layers with higher alpha values and dithering -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark base color -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/background" />
        </shape>
    </item>
    <!-- Subtle top-right cyan glow -->
    <item>
        <shape android:shape="rectangle" android:dither="true">
            <gradient
                android:type="radial"
                android:centerX="0.85"
                android:centerY="0.15"
                android:gradientRadius="50%p"
                android:startColor="#2000DDFF"
                android:endColor="#00000000"
                android:dither="true" />
        </shape>
    </item>
    <!-- Subtle bottom-left pink glow -->
    <item>
        <shape android:shape="rectangle" android:dither="true">
            <gradient
                android:type="radial"
                android:centerX="0.15"
                android:centerY="0.85"
                android:gradientRadius="50%p"
                android:startColor="#18B71AEB"
                android:endColor="#00000000"
                android:dither="true" />
        </shape>
    </item>
    <!-- Center purple accent - subtle -->
    <item>
        <shape android:shape="rectangle" android:dither="true">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.5"
                android:gradientRadius="70%p"
                android:startColor="#102B1FD0"
                android:endColor="#00000000"
                android:dither="true" />
        </shape>
    </item>
    <!-- Bottom-right gold glow (matching website aesthetic) -->
    <item>
        <shape android:shape="rectangle" android:dither="true">
            <gradient
                android:type="radial"
                android:centerX="0.80"
                android:centerY="0.70"
                android:gradientRadius="35%p"
                android:startColor="#0CFFE57C"
                android:endColor="#00000000"
                android:dither="true" />
        </shape>
    </item>
</layer-list>
