<?xml version="1.0" encoding="utf-8"?>
<!-- Cyan action button gradient matching website primary button -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/iisu_cyan_light">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/button_secondary_start"
                android:endColor="@color/button_secondary_end"
                android:angle="0" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</ripple>
