<?xml version="1.0" encoding="utf-8"?>
<!-- iiSU Network chip/radio selector with gradient accent -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Checked state - iiSU gradient background -->
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="0"
                        android:startColor="#00DDFF"
                        android:centerColor="#2B1FD0"
                        android:endColor="#B71AEB" />
                    <corners android:radius="@dimen/card_corner_radius" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/selection_background" />
            <stroke android:width="1dp" android:color="@color/iisu_cyan" />
            <corners android:radius="@dimen/card_corner_radius" />
        </shape>
    </item>
    <!-- Focused state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/theme_surface_variant" />
            <stroke android:width="2dp" android:color="@color/iisu_cyan" />
            <corners android:radius="@dimen/card_corner_radius" />
        </shape>
    </item>
    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/theme_surface_variant" />
            <stroke android:width="1dp" android:color="@color/theme_border" />
            <corners android:radius="@dimen/card_corner_radius" />
        </shape>
    </item>
</selector>
