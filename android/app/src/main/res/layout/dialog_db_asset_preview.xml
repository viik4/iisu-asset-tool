<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@drawable/bg_dialog"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textDbGameTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold"
                android:textColor="@color/theme_text_primary"
                android:ellipsize="end"
                android:maxLines="2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:icon="@drawable/ic_close"
                app:iconSize="20dp"
                app:iconTint="@color/theme_text_secondary"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                style="@style/Widget.Material3.Button.TextButton" />

        </LinearLayout>

        <!-- Target game selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/spacing_sm"
            android:padding="10dp"
            android:background="@drawable/rounded_corners_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apply to game in library:"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/theme_text_secondary"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/textTargetGameName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Searching library..."
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/accent_cyan"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangeGame"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Change"
                    android:textSize="11sp"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

            </LinearLayout>

            <!-- Selected game path indicator -->
            <TextView
                android:id="@+id/textSelectedGamePath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="9sp"
                android:textColor="@color/theme_text_tertiary"
                android:ellipsize="middle"
                android:singleLine="true"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Asset tabs -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutAssets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@android:color/transparent"
            app:tabMode="fixed"
            app:tabGravity="fill"
            app:tabTextColor="@color/theme_text_secondary"
            app:tabSelectedTextColor="@color/accent_cyan"
            app:tabIndicatorColor="@color/accent_cyan"
            app:tabIndicatorHeight="2dp"
            android:minHeight="36dp" />

        <!-- Preview comparison: Current vs DB -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_sm"
            android:baselineAligned="false">

            <!-- Current asset -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/theme_text_secondary"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/rounded_corners_bg">

                    <ImageView
                        android:id="@+id/imageCurrentAsset"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:padding="4dp" />

                    <TextView
                        android:id="@+id/textNoCurrentAsset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="No asset"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/theme_text_secondary"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:id="@+id/textCurrentInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="9sp"
                    android:textColor="@color/theme_text_secondary" />

            </LinearLayout>

            <!-- Arrow indicator -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                android:rotation="180"
                app:tint="@color/accent_cyan"
                android:contentDescription="Replace with" />

            <!-- DB asset -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="From Server"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/accent_cyan"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/rounded_corners_bg">

                    <ImageView
                        android:id="@+id/imageDbAsset"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:padding="4dp" />

                    <ProgressBar
                        android:id="@+id/progressDbAsset"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/textNoDbAsset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Not in DB"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/theme_text_secondary"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:id="@+id/textDbInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="9sp"
                    android:textColor="@color/theme_text_secondary" />

            </LinearLayout>

        </LinearLayout>

        <!-- Asset checklist -->
        <LinearLayout
            android:id="@+id/layoutAssetChecklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/spacing_sm"
            android:padding="8dp"
            android:background="@drawable/rounded_corners_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assets to apply:"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/theme_text_secondary"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <CheckBox
                    android:id="@+id/checkIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Icon"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/theme_text_primary"
                    android:checked="true"
                    android:minHeight="36dp" />

                <CheckBox
                    android:id="@+id/checkHero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hero"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/theme_text_primary"
                    android:checked="true"
                    android:minHeight="36dp"
                    android:layout_marginStart="8dp" />

                <CheckBox
                    android:id="@+id/checkLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logo"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/theme_text_primary"
                    android:checked="true"
                    android:minHeight="36dp"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Cancel"
                android:textSize="13sp"
                style="@style/Widget.Material3.Button.TextButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApply"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Apply Assets"
                android:textSize="13sp"
                android:textColor="@color/white"
                app:backgroundTint="@color/accent_cyan"
                app:cornerRadius="8dp" />

        </LinearLayout>

        <!-- Progress indicator -->
        <ProgressBar
            android:id="@+id/progressApply"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:indeterminate="true" />

    </LinearLayout>

</ScrollView>
