<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_background"
    android:orientation="vertical">

    <!-- Header with title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_sm">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            style="@style/IisuTextAppearance.PageTitle" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_accent_line" />

    </LinearLayout>

    <!-- Tab Layout - like iiSU Launcher settings tabs -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:layout_marginBottom="@dimen/spacing_sm"
        app:cardBackgroundColor="@color/theme_surface"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/theme_border">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutSettings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:tabMode="scrollable"
            app:tabGravity="start"
            app:tabIndicatorColor="@color/theme_accent"
            app:tabIndicatorHeight="3dp"
            app:tabSelectedTextColor="@color/theme_accent"
            app:tabTextColor="@color/theme_text_secondary"
            app:tabRippleColor="@color/theme_accent_transparent"
            app:tabPaddingStart="16dp"
            app:tabPaddingEnd="16dp"
            android:background="@android:color/transparent" />

    </com.google.android.material.card.MaterialCardView>

    <!-- ViewPager2 for tab content -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerSettings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
