<?xml version="1.0" encoding="utf-8"?>
<!-- Display Options tab content -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <!-- Theme Selection -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardBackgroundColor="@color/theme_surface"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/theme_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_theme"
                    style="@style/IisuTextAppearance.SectionHeader"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_theme_desc"
                    android:textSize="12sp"
                    android:textColor="@color/theme_text_secondary"
                    android:layout_marginBottom="@dimen/spacing_md" />

                <RadioGroup
                    android:id="@+id/radioGroupTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioThemeSystem"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="@string/settings_theme_system"
                        android:textSize="13sp"
                        android:button="@null"
                        android:gravity="center"
                        android:focusable="true"
                        android:background="@drawable/selector_chip" />

                    <RadioButton
                        android:id="@+id/radioThemeDark"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="@dimen/spacing_sm"
                        android:text="@string/settings_theme_dark"
                        android:textSize="13sp"
                        android:button="@null"
                        android:gravity="center"
                        android:focusable="true"
                        android:background="@drawable/selector_chip" />

                    <RadioButton
                        android:id="@+id/radioThemeLight"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="@string/settings_theme_light"
                        android:textSize="13sp"
                        android:button="@null"
                        android:gravity="center"
                        android:focusable="true"
                        android:background="@drawable/selector_chip" />

                </RadioGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Background Music Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardBackgroundColor="@color/theme_surface"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/theme_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_section_music"
                    style="@style/IisuTextAppearance.SectionHeader"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <!-- Enable Music Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_music_enabled"
                            android:textSize="14sp"
                            android:textColor="@color/theme_text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_music_enabled_desc"
                            android:textSize="12sp"
                            android:textColor="@color/theme_text_secondary" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchMusicEnabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- Volume Slider -->
                <LinearLayout
                    android:id="@+id/layoutVolumeSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_music_volume"
                        android:textSize="14sp"
                        android:textColor="@color/theme_text_primary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderVolume"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:valueFrom="0"
                            android:valueTo="100"
                            android:stepSize="1"
                            app:trackColorActive="@color/accent_cyan"
                            app:trackColorInactive="@color/theme_border"
                            app:thumbColor="@color/accent_cyan" />

                        <TextView
                            android:id="@+id/textVolumePercent"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:textSize="14sp"
                            android:textColor="@color/theme_text_secondary"
                            android:text="50%" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Music Credit -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/settings_music_credit"
                    android:textSize="12sp"
                    android:textColor="@color/accent_cyan"
                    android:textStyle="italic" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- About Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/theme_surface"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/theme_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg"
                android:gravity="center_horizontal">

                <ImageView
                    android:id="@+id/imageIisuLogo"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/app_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/app_name" />

                <TextView
                    android:id="@+id/textVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textSize="14sp"
                    android:textColor="@color/theme_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/settings_about_desc"
                    android:textSize="12sp"
                    android:textColor="@color/theme_text_tertiary"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/settings_music_credits"
                    android:textSize="11sp"
                    android:textColor="@color/accent_cyan"
                    android:textStyle="italic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/settings_logo_credits"
                    android:textSize="11sp"
                    android:textColor="@color/accent_cyan"
                    android:textStyle="italic" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
