<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    app:cardBackgroundColor="@color/theme_surface"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/theme_border_color">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp">

        <!-- Game icon preview - square aspect ratio using aspectRatio -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/frameIcon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal">

            <ImageView
                android:id="@+id/imageGameIcon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                android:background="@drawable/rounded_corners_bg"
                android:clipToOutline="true"
                app:layout_constraintDimensionRatio="H,1:1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:src="@drawable/ic_image_placeholder" />

            <!-- Missing icon indicator -->
            <ImageView
                android:id="@+id/iconMissingIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_missing_icon"
                android:visibility="gone"
                app:tint="@color/accent_cyan"
                app:layout_constraintBottom_toBottomOf="@id/imageGameIcon"
                app:layout_constraintEnd_toEndOf="@id/imageGameIcon" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Game title -->
        <TextView
            android:id="@+id/textGameName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textSize="9sp"
            android:textColor="@color/theme_text_primary"
            tools:text="Super Mario Bros. 3" />

        <!-- Asset status row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/textIconStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="8sp"
                android:textColor="@color/theme_text_secondary"
                tools:text="I" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:text="/"
                android:textSize="8sp"
                android:textColor="@color/theme_text_secondary" />

            <TextView
                android:id="@+id/textHeroStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="8sp"
                android:textColor="@color/theme_text_secondary"
                tools:text="H" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:text="/"
                android:textSize="8sp"
                android:textColor="@color/theme_text_secondary" />

            <TextView
                android:id="@+id/textLogoStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="8sp"
                android:textColor="@color/theme_text_secondary"
                tools:text="L" />

        </LinearLayout>

        <!-- Action buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnGenerateIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_icons"
                android:contentDescription="Generate Icon"
                app:tint="@color/accent_cyan" />

            <ImageButton
                android:id="@+id/btnGenerateHero"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_hero"
                android:contentDescription="Generate Hero"
                android:visibility="gone"
                app:tint="@color/accent_cyan" />

            <ImageButton
                android:id="@+id/btnGenerateLogo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_logo"
                android:contentDescription="Generate Logo"
                android:visibility="gone"
                app:tint="@color/accent_magenta" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
