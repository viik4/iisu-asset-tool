<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="80dp"
    android:paddingVertical="40dp">

    <!-- Icon on the left -->
    <ImageView
        android:id="@+id/onboardingIcon"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:contentDescription="@string/onboarding_icon_desc"
        android:src="@drawable/ic_logo"
        android:scaleType="fitCenter" />

    <!-- Spacer -->
    <View
        android:layout_width="48dp"
        android:layout_height="0dp" />

    <!-- Text on the right -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="start">

        <TextView
            android:id="@+id/onboardingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_welcome_title"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="@font/continuum"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/onboardingSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_welcome_subtitle"
            android:textColor="@color/dark_text_hint"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.4"
            android:maxWidth="450dp" />

    </LinearLayout>

</LinearLayout>
