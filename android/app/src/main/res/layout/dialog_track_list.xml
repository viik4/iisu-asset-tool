<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:padding="16dp">

    <!-- Helper text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select a track to preview and download"
        android:textSize="12sp"
        android:textColor="@color/theme_text_secondary"
        android:layout_marginBottom="8dp" />

    <!-- Track list -->
    <ListView
        android:id="@+id/listTracks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/theme_divider"
        android:dividerHeight="1dp"
        android:choiceMode="singleChoice"
        android:background="@drawable/rounded_corners_bg" />

    <!-- Selected track info + Preview controls panel -->
    <LinearLayout
        android:id="@+id/layoutSelectedTrack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="10dp"
        android:padding="10dp"
        android:background="@drawable/rounded_corners_bg">

        <TextView
            android:id="@+id/textSelectedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/accent_cyan"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/textSelectedInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11sp"
            android:textColor="@color/theme_text_secondary" />

        <!-- Preview playback controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreview"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="▶ Preview"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStop"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="⏹ Stop"
                android:textSize="11sp"
                android:visibility="gone"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <ProgressBar
                android:id="@+id/progressPreview"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textPreviewStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textSize="10sp"
                android:textColor="@color/theme_text_secondary"
                android:ellipsize="end"
                android:maxLines="1" />

        </LinearLayout>

        <!-- Volume slider row -->
        <LinearLayout
            android:id="@+id/layoutVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekVolume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:max="100"
                android:progress="70" />

            <TextView
                android:id="@+id/textVolumePercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="70%"
                android:textSize="10sp"
                android:textColor="@color/theme_text_secondary" />

        </LinearLayout>

    </LinearLayout>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Cancel"
            android:textSize="13sp"
            style="@style/Widget.Material3.Button.TextButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownload"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Download"
            android:textSize="13sp"
            android:textColor="@color/white"
            app:backgroundTint="@color/accent_cyan"
            app:cornerRadius="8dp"
            android:enabled="false" />

    </LinearLayout>

</LinearLayout>
