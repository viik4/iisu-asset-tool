<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_background">

    <!-- Not Installed State -->
    <LinearLayout
        android:id="@+id/layoutNotInstalled"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_xl"
        android:visibility="gone">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_iisu_home"
            android:alpha="0.5"
            android:contentDescription="@string/iisu_not_installed" />

        <TextView
            android:id="@+id/textNotInstalledTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/iisu_not_installed"
            style="@style/IisuTextAppearance.HeadlineSmall" />

        <TextView
            android:id="@+id/textNotInstalledDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/iisu_not_installed_desc"
            style="@style/IisuTextAppearance.Description"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectRomFolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/select_rom_folder"
            style="@style/IisuPrimaryButton"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_folder"
            app:iconTint="@color/theme_text_primary"
            app:cornerRadius="8dp" />

    </LinearLayout>

    <!-- Browser Layout -->
    <LinearLayout
        android:id="@+id/layoutBrowser"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md"
        android:visibility="gone">

        <!-- Title Row with iiSU Page Title style -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/iisu_browser_title"
                style="@style/IisuTextAppearance.PageTitle" />

            <!-- Refresh Button -->
            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_refresh"
                android:contentDescription="Refresh"
                android:padding="8dp"
                app:tint="@color/theme_text_secondary" />
        </LinearLayout>

        <!-- Accent line under title -->
        <View
            android:id="@+id/accentLine"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_accent_line" />

        <!-- Scrollable content for platforms and Android apps -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Platforms Section -->
                <TextView
                    android:id="@+id/textPlatformsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/iisu_platforms"
                    style="@style/IisuTextAppearance.SectionHeader" />

                <!-- Platform Grid -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewPlatforms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_platform" />

                <!-- Empty State -->
                <TextView
                    android:id="@+id/textEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="@dimen/spacing_xl"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/theme_text_secondary"
                    android:visibility="gone" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- Progress Bar Overlay (outside LinearLayout so it doesn't affect layout flow) -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />

</FrameLayout>
