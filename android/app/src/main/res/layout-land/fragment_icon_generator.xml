<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape layout - optimized horizontal layout -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_background"
    android:padding="@dimen/spacing_md">

    <!-- Hidden views for compatibility with portrait layout -->
    <TextView
        android:id="@+id/textTitle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Left Column: Search Controls -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSearch"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/spacing_sm"
        app:cardBackgroundColor="@color/theme_surface"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/theme_border"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cardPreview"
        app:layout_constraintWidth_percent="0.45">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/layoutSearchContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <!-- Header with collapse button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Search"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_cyan" />

                    <ImageButton
                        android:id="@+id/btnCollapseSearch"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_expand_less"
                        android:contentDescription="Collapse search"
                        android:visibility="gone"
                        app:tint="@color/theme_text_secondary" />

                </LinearLayout>

                <!-- Expandable Content -->
                <LinearLayout
                    android:id="@+id/layoutExpandableContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <!-- Search Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:hint="@string/icon_search_hint"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_search"
                    app:endIconTint="@color/theme_accent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:imeOptions="actionSearch"
                        android:textSize="14sp"
                        android:textColor="@color/theme_text_primary" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Filters Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:baselineAligned="false">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutPlatform"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:hint="@string/icon_platform_label">

                        <AutoCompleteTextView
                            android:id="@+id/spinnerPlatform"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textSize="13sp"
                            android:textColor="@color/theme_text_primary" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutArtworkType"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_xs"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:hint="@string/icon_artwork_type_label">

                        <AutoCompleteTextView
                            android:id="@+id/spinnerArtworkType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textSize="13sp"
                            android:textColor="@color/theme_text_primary" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- Search Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/icon_generate_button"
                    android:minHeight="44dp"
                    style="@style/IisuPrimaryButton"
                    app:backgroundTint="@null"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_search"
                    app:iconGravity="textStart" />

                </LinearLayout>
                <!-- End Expandable Content -->

                <!-- Status Row -->
                <LinearLayout
                    android:id="@+id/layoutStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorSize="18dp"
                        app:trackThickness="2dp"
                        app:indicatorColor="@color/theme_accent" />

                    <TextView
                        android:id="@+id/textResultCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:textSize="12sp"
                        android:textColor="@color/theme_text_secondary"
                        tools:text="5 results" />

                    <!-- Expand button when collapsed -->
                    <ImageButton
                        android:id="@+id/btnExpandSearch"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_expand_more"
                        android:contentDescription="Expand search"
                        android:visibility="gone"
                        app:tint="@color/theme_accent" />

                </LinearLayout>

                <!-- Search Results - Bigger for artwork options -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerSearchResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:clipToPadding="false"
                    android:visibility="gone"
                    android:minHeight="140dp"
                    android:maxHeight="200dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_game_search" />

            </LinearLayout>

        </ScrollView>

    </com.google.android.material.card.MaterialCardView>

    <!-- Right Column: Preview -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_marginBottom="56dp"
        app:cardBackgroundColor="@color/theme_surface"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/theme_border"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/cardSearch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.55">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imagePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:padding="@dimen/spacing_md"
                android:contentDescription="@string/cd_preview"
                tools:src="@android:drawable/ic_menu_gallery" />

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/layoutEmptyPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_image_placeholder"
                    android:alpha="0.4"
                    app:tint="@color/theme_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="Search for a game to preview artwork"
                    android:textSize="12sp"
                    android:textColor="@color/theme_text_hint" />

            </LinearLayout>

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Save Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonSave"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="@string/icon_save_button"
        android:minHeight="44dp"
        android:enabled="false"
        style="@style/IisuSecondaryButton"
        app:backgroundTint="@null"
        app:icon="@drawable/ic_save"
        app:iconGravity="textStart"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/cardPreview"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
